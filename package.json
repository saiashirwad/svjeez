{
  "name": "svjeez",
  "version": "0.5.0",
  "type": "module",
  "sideEffects": false,
  "types": "./package-dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "package-dist/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "default": "./package-dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./package-dist/jsx-runtime.d.ts",
      "default": "./package-dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./package-dist/jsx-dev-runtime.d.ts",
      "default": "./package-dist/jsx-dev-runtime.js"
    },
    "./extras": {
      "types": "./package-dist/extras.d.ts",
      "default": "./package-dist/extras.js"
    },
    "./frames": {
      "types": "./package-dist/frames.d.ts",
      "default": "./package-dist/frames.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "svjeez": "./package-dist/cli.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/preview.ts",
    "test": "bun test",
    "test:node": "tsx scripts/node-check.ts",
    "test:package": "tsx scripts/package-check.ts",
    "typecheck": "tsc --noEmit",
    "build:package": "bun run scripts/package.ts",
    "prepack": "bun run build:package",
    "svjeez": "bun run src/cli.ts",
    "render-png": "bun run src/cli.ts render"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "latest",
    "playwright-core": "^1.64.1",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "latest"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49",
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "description": "Animated SVGs in TSX. One file out, no JavaScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git"
  },
  "files": [
    "package-dist",
    "skills"
  ]
}
