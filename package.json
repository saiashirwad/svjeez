{
  "name": "svjeez",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./package-dist/jsx-runtime.d.ts",
      "import": "./package-dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./package-dist/jsx-dev-runtime.d.ts",
      "import": "./package-dist/jsx-dev-runtime.js"
    },
    "./extras": {
      "types": "./package-dist/extras.d.ts",
      "import": "./package-dist/extras.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/preview.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:package": "bun run scripts/package.ts",
    "prepack": "bun run build:package"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "description": "Animated SVGs in TSX. One file out, no JavaScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git"
  },
  "files": [
    "package-dist"
  ]
}
