    "@svjeez/mermaid": "workspace:*",
    "ai": "^7.0.173",
    "alchemy": "2.0.0-beta.87",
    "d3-geo": "^3.1.1",
    "effect": "^4.1.4",
    "es-module-lexer": "^3.0.4",
    "hono": "^4.13.19",
