amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["lint"] { check = "bun run lint" }
  ["format"] {
    check = "bun run format:check"
    fix = "bun run format"
  }
  ["typecheck"] { check = "bun run typecheck" }
}

hooks {
  ["pre-push"] { steps = checks }
  ["fix"] {
    fix = true
    steps = checks
  }
}
