{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["@svjeez/source"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"],
    "paths": {
      "svjeez": ["../svjeez/src/index.ts"],
      "svjeez/tools": ["../svjeez/src/tools.ts"],
      "svjeez/jsx-runtime": ["../svjeez/src/jsx-runtime.ts"],
      "svjeez/jsx-dev-runtime": ["../svjeez/src/jsx-dev-runtime.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "svjeez"
  },
  "include": ["src", "test"]
}
