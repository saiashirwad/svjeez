{
  "name": "@svjeez/dom",
  "version": "0.8.0-next.0",
  "private": true,
  "description": "Capture a live DOM subtree as a plain, versioned JSON Snapshot that svjeez can compile into a scene, or film a web app into one.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/dom"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun.ts",
    "./bun/preload": "./src/bun-preload.ts",
    "./vite": "./src/vite.ts",
    "./react": "./src/frameworks/react.ts",
    "./svelte": "./src/frameworks/svelte.ts"
  },
  "scripts": {
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-plugin-svelte": "^0.0.6",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.58.0",
    "svjeez": "workspace:*",
    "typescript": "latest",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "bun-plugin-svelte": ">=0.0.6",
    "playwright-core": ">=1.49",
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "svjeez": "workspace:^",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "bun-plugin-svelte": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
