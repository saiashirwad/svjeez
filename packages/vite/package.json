{
  "name": "@svjeez/vite",
  "version": "0.6.1",
  "private": true,
  "description": "Vite plugin for svjeez: import a scene with ?svjeez and get an animated SVG's URL, with poster stills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/scene.ts",
    "./encode": "./src/encode.ts",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "dev": "bun --conditions @svjeez/source test/app/dev.ts",
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svjeez": "workspace:*",
    "typescript": "latest",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49",
    "svjeez": ">=0.6.0 <1",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
