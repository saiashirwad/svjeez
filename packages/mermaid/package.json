{
  "name": "@svjeez/mermaid",
  "version": "0.8.0-next.4",
  "description": "Mermaid text drawn as svjeez diagrams, from flowcharts and sequence diagrams to pie, radar and xy charts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/mermaid"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "dependencies": {
    "@svjeez/diagrams": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "svjeez": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
