{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "svjeez",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "svjeez": ["./src/index.ts"],
      "svjeez/jsx-runtime": ["./src/jsx-runtime.ts"],
      "svjeez/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "svjeez/extras": ["./src/extras.ts"],
      "svjeez/frames": ["./src/frames.ts"],
      "svjeez/page": ["./src/page.ts"],
      "svjeez/params": ["./src/params.ts"],
      "svjeez/voxel": ["./src/voxel.ts"]
    }
  },
  "include": ["src", "scripts", "skills", "test"]
}
