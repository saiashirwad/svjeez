{
  "name": "@svjeez/code",
  "version": "0.6.1",
  "private": true,
  "description": "Syntax highlighting for svjeez: source text to role-tagged runs that code() and terminal() color from the scene's theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/code"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "dependencies": {
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "svjeez": ">=0.6.0 <1"
  },
  "engines": {
    "node": ">=20"
  }
}
