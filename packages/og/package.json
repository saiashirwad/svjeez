{
  "name": "@svjeez/og",
  "version": "0.8.0-next.2",
  "description": "Link-preview cards for svjeez: write an og:image as a scene, render it to a PNG, JPEG or WebP in headless Chromium.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/og"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.ts",
    "./settings": "./src/settings.ts"
  },
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "^1.64.1",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49",
    "svjeez": "workspace:^"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
