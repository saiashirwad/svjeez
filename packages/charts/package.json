{
  "name": "@svjeez/charts",
  "version": "0.8.0-next.4",
  "description": "Animated bar, line and area charts for svjeez scenes: shared axes, scales fitted to the data, series that grow and draw on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/charts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "dependencies": {
    "@types/d3-shape": "3.2.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/d3-scale": "4.0.9",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "svjeez": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
