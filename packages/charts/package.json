{
  "name": "@svjeez/charts",
  "version": "0.6.1",
  "private": true,
  "description": "Animated bar, line and area charts for svjeez: scales and paths computed while the scene builds, drawn on by the timeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/charts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "dependencies": {
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "svjeez": ">=0.6.0 <1"
  },
  "engines": {
    "node": ">=20"
  }
}
