{
  "name": "@svjeez/astro",
  "version": "0.1.0",
  "private": true,
  "description": "Astro integration for svjeez: import a scene into a page and get an animated SVG, with poster stills.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/scene.ts",
    "./Scene.astro": "./src/Scene.astro",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "dependencies": {
    "@svjeez/vite": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=7"
  },
  "devDependencies": {
    "astro": "^7.4.3",
    "typescript": "6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/astro"
  }
}
