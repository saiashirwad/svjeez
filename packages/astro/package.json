{
  "name": "@svjeez/astro",
  "version": "0.8.0-next.3",
  "description": "Astro integration for svjeez: import a scene into a page and get an animated SVG, with poster stills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/astro"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scene": "./src/scene.ts",
    "./Scene.astro": "./src/Scene.astro",
    "./Og.astro": "./src/Og.astro",
    "./dev/Gallery.astro": "./src/dev/Gallery.astro",
    "./og": "./src/og.ts",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "dependencies": {
    "@svjeez/vite": "workspace:^"
  },
  "devDependencies": {
    "astro": "^7.4.3",
    "svjeez": "workspace:*",
    "typescript": "6"
  },
  "peerDependencies": {
    "astro": ">=7",
    "svjeez": "workspace:^"
  }
}
