{
  "name": "@svjeez/video",
  "version": "0.8.0-next.2",
  "description": "MP4 and WebM video from an svjeez SVG, encoded in headless Chromium with Mediabunny.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/video"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "dependencies": {
    "mediabunny": "1.63.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "^1.64.1",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49",
    "svjeez": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  }
}
