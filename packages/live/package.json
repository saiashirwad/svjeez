{
  "name": "@svjeez/live",
  "private": true,
  "description": "Scene source as data for the site's editors: parse, highlight and edit TSX, compile source in a worker, and edit a scene by the handles on its picture in Svelte. Never published.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./source": "./src/source.ts",
    "./doc": "./src/doc.ts",
    "./compile": "./src/compile.ts",
    "./client": "./src/client.ts",
    "./gzip": "./src/gzip.ts",
    "./svelte": "./src/svelte/index.ts"
  },
  "scripts": {
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold warning"
  },
  "dependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@svjeez/charts": "workspace:*",
    "@svjeez/code": "workspace:*",
    "@svjeez/geo": "workspace:*",
    "@svjeez/icons": "workspace:*",
    "@svjeez/math": "workspace:*",
    "@svjeez/mermaid": "workspace:*",
    "sucrase": "^3.35.1",
    "svjeez": "workspace:*",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "6"
  },
  "peerDependencies": {
    "svelte": "^5.57.3"
  }
}
