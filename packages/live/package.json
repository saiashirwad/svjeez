{
  "name": "@svjeez/live",
  "version": "0.6.1",
  "private": true,
  "description": "Edit a svjeez scene's source through controls: every number, color and ease in the file as a control, one store that compiles in a worker and keeps the picture's clock, for any framework to bind.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/live"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source.ts",
    "./controls": "./src/controls.ts",
    "./editor": "./src/editor.ts",
    "./compile": "./src/compile.ts",
    "./client": "./src/client.ts",
    "./gzip": "./src/gzip.ts",
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "dependencies": {
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@svjeez/charts": "workspace:*",
    "@svjeez/code": "workspace:*",
    "@svjeez/geo": "workspace:*",
    "@svjeez/icons": "workspace:*",
    "@svjeez/math": "workspace:*",
    "@svjeez/mermaid": "workspace:*",
    "sucrase": "^3.35.1",
    "svjeez": "workspace:*",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "^1.64.1",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
