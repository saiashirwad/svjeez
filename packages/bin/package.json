{
  "name": "@svjeez/bin",
  "version": "0.8.0-next.3",
  "description": "svjeez as one executable: write a scene file anywhere and run svjeez check, frames, svg, dev or video on it, with no package.json or node_modules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/bin"
  },
  "type": "module",
  "publishConfig": {
    "directory": "package-dist"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:package": "bun scripts/package.ts",
    "test": "bun test --timeout 30000",
    "test:package": "bun scripts/package-check.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "echo \"Publish package-dist instead: bun scripts/release.ts publishes it.\" >&2 && exit 1"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.1.4",
    "@svjeez/charts": "workspace:*",
    "@svjeez/code": "workspace:*",
    "@svjeez/diagrams": "workspace:*",
    "@svjeez/fonts": "workspace:*",
    "@svjeez/geo": "workspace:*",
    "@svjeez/icons": "workspace:*",
    "@svjeez/math": "workspace:*",
    "@svjeez/mermaid": "workspace:*",
    "@svjeez/video": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "26.6.5",
    "effect": "^4.1.4",
    "playwright-core": "1.64.1",
    "svjeez": "workspace:*",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
