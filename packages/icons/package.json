{
  "name": "@svjeez/icons",
  "version": "0.8.0-next.0",
  "private": true,
  "description": "Tabler and Lucide icons for svjeez scenes: an <Icon> that draws, recolors and animates each piece.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saiashirwad/svjeez.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tabler": "./src/tabler.ts",
    "./lucide": "./src/lucide.ts"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "test": "bun test --conditions @svjeez/source",
    "typecheck": "tsc --noEmit",
    "build:package": "bun ../../scripts/package-plugin.ts",
    "test:package": "bun ../../scripts/package-plugin-check.ts"
  },
  "devDependencies": {
    "@tabler/icons": "3.50.0",
    "@types/bun": "latest",
    "lucide-static": "1.63.0",
    "svjeez": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "svjeez": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  }
}
