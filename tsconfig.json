{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "svg-motion",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "svg-motion": [
        "./src/index.ts"
      ],
      "svg-motion/jsx-runtime": [
        "./src/jsx-runtime.ts"
      ],
      "svg-motion/jsx-dev-runtime": [
        "./src/jsx-dev-runtime.ts"
      ],
      "svjeez/extras": [
        "./src/extras.ts"
      ]
    }
  },
  "include": [
    "src",
    "examples",
    "scripts",
    "tests"
  ]
}
