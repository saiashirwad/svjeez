---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import { DEFAULT_PALETTE, PALETTES } from "../palettes";
import { codeVars } from "../styles/code";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** The title and description a link preview shows, when they differ from the page's. */
  share?: { title: string; description: string; alt?: string };
  class?: string;
  current?: "examples" | "intro" | "play";
  wide?: boolean;
  /** Which link-preview card the page shares: one of /og/<card>.jpg. */
  card?: string;
}

const { title, description, share = { title, description }, class: className, current, wide, card = "home" } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`/og/${card}.jpg`, Astro.site);
const home = Astro.url.pathname === "/";

const site = { "@type": "WebSite", name: "svjeez", url: new URL("/", Astro.site).href };

const software = {
  "@type": "SoftwareSourceCode",
  name: "svjeez",
  description,
  url: site.url,
  codeRepository: "https://github.com/saiashirwad/svjeez",
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/license/mit",
};

const jsonLd = { "@context": "https://schema.org", "@graph": home ? [site, software] : [site] };
const picked = PALETTES.map(({ id }) => id).filter((id) => id !== DEFAULT_PALETTE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="svjeez" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={share.title} />
    <meta property="og:description" content={share.description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {share.alt && <meta property="og:image:alt" content={share.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={share.title} />
    <meta name="twitter:description" content={share.description} />
    <meta name="twitter:image" content={image} />
    <script is:inline define:vars={{ picked }}>
      try {
        var t = localStorage.getItem("theme");

        if (t) document.documentElement.dataset.theme = t;
        var p = localStorage.getItem("palette");

        if (picked.indexOf(p) >= 0) document.documentElement.dataset.palette = p;
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-mono" preload />
    <style is:inline set:html={codeVars}></style>
    <slot name="head" />
  </head>
  <body class={className}>
    <Header current={current} wide={wide} />
    <slot />
  </body>
</html>
