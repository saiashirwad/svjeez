---
import Base from "../../layouts/Base.astro";
import { SPEC, type ChoiceKey, type NumericKey, type Plan, type Arrangement, type Tip, type Quirk, type Fur } from "../../lab/e/genome";
import { H, W } from "../../lab/e/geometry";
import { PALETTES } from "../../lab/e/palette";
import "../../lab/e/lab.css";

const parts = [
  { part: "heads", d: "M7 20a9 8 0 1 0 18 0a9 8 0 1 0-18 0M8 15l1-9 6 5M24 15l-1-9-6 5" },
  { part: "ears", d: "M9 24l7-16 7 16z" },
  { part: "eyes", d: "M6 16a10 7 0 1 0 20 0a10 7 0 1 0-20 0M14 16a2 5 0 1 0 4 0a2 5 0 1 0-4 0" },
  { part: "legs", d: "M16 4v20M11 26a5 3 0 1 0 10 0a5 3 0 1 0-10 0" },
  { part: "tails", d: "M10 28C14 20 6 14 13 8S22 6 22 4" },
];

const plan: Record<Plan, string> = {
  line: "M3 12h18",
  loop: "M8 4a8 8 0 1 0 8 0",
  spiral: "M12 12a2 2 0 1 1 2 2a4 4 0 1 1-5-5a6.5 6.5 0 1 1-6 7",
  knot: "M8 19C2 14 8 4 12 6s6 10 4 13-10 0-11-4 9-9 13-5",
};
const arrangement: Record<Arrangement, string> = {
  ends: "M3 12h18M3 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M21 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0",
  stack: "M3 18h12M17 18m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M17 11.5m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M17 5m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0",
  orbit: "M7 12h10M12 12m-10 0a10 7 0 1 0 20 0a10 7 0 1 0-20 0M22 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M2 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0",
};
const tip: Record<Tip, string> = {
  tuft: "M8 22C12 16 4 10 12 6M12 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0",
  kitten: "M6 22C10 16 4 12 10 9M14 7m-4 0a4 3.5 0 1 0 8 0a4 3.5 0 1 0-8 0M10.5 4.5l0.5-3 2 2M17.5 4.5l-.5-3-2 2",
  fork: "M8 22C12 16 6 12 12 9M12 9l-5-6M12 9l6-5",
  eye: "M8 22C12 16 4 11 11 8M13 6m-5 0a5 3.5 0 1 0 10 0a5 3.5 0 1 0-10 0M13 6m-1 0a1 2.5 0 1 0 2 0a1 2.5 0 1 0-2 0",
};
const quirk: Record<Quirk, string> = {
  spin: "M12 4a8 8 0 1 1-7.5 5.2M4 4v5h5",
  wrap: "M2 12h20M18 8l4 4-4 4M2 6v12M22 6v12",
  split: "M10 4v16M14 4v16M6 8l-3 4 3 4M18 8l3 4-3 4",
  hat: "M5 18h14M8 18V6h8v12M4 18a8 2 0 0 0 16 0",
  float: "M12 20V6M8 10l4-4 4 4M7 22h10",
  none: "M6 12h12",
};
const swatch = (fur: Fur) => {
  const { base, dark, light } = PALETTES[fur];
  if (fur === "calico") return `conic-gradient(${base} 0 50%, ${light} 0 75%, ${dark} 0)`;
  if (fur === "cosmic") return `radial-gradient(circle at 30% 30%, ${light} 0 8%, ${base} 9%)`;
  return base;
};

const icon = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}"/></svg>`;
const words = <T extends string>(options: readonly T[]) => options.map((v) => ({ v, html: v }));
const icons = <T extends string>(options: readonly T[], paths: Record<T, string>) => options.map((v) => ({ v, html: icon(paths[v]) }));
const swatches = SPEC.fur.options.map((v) => ({ v, html: `<i style="background:${swatch(v)}"></i>` }));

/** One row per choice gene: what the row is called, its buttons, and the number genes scrubbed beside it. */
const rows: { gene: ChoiceKey; label: string; options: { v: string; html: string }[]; scrub: NumericKey[] }[] = [
  { gene: "plan", label: "plan", options: icons(SPEC.plan.options, plan), scrub: ["length", "girth"] },
  { gene: "arrangement", label: "heads", options: icons(SPEC.arrangement.options, arrangement), scrub: [] },
  { gene: "legSide", label: "legs", options: words(SPEC.legSide.options), scrub: ["legLength"] },
  { gene: "tip", label: "tail", options: icons(SPEC.tip.options, tip), scrub: ["tailLength"] },
  { gene: "dimension", label: "dimension", options: words(SPEC.dimension.options), scrub: ["slice"] },
  { gene: "oid", label: "-oid", options: words(SPEC.oid.options), scrub: ["oidness"] },
  { gene: "fur", label: "fur", options: swatches, scrub: [] },
  { gene: "pattern", label: "pattern", options: words(SPEC.pattern.options), scrub: [] },
  { gene: "quirk", label: "quirk", options: icons(SPEC.quirk.options, quirk), scrub: ["ink"] },
];
---

<Base title="Catoid · svjeez lab" description="A catoid maker. Every gene you change compiles a new animated SVG.">
  <main class="lab-e">
    <section class="le-stage" aria-label="Specimen">
      <div class="le-fit">
        <div class="le-frame" data-frame>
          <img data-stage alt="" width={W} height={H} />
          <svg data-overlay viewBox={`0 0 ${W} ${H}`} aria-hidden="true"></svg>
        </div>
      </div>
      <p class="le-error" data-error hidden></p>
    </section>

    <aside class="le-side">
      <header class="le-card">
        <p class="le-no"><span data-no></span> <span class="muted" data-lineage></span></p>
        <h1 data-name></h1>
        <p class="le-stamp" data-stamp>
          <span>ISO 1-CAT:2026</span>
          <b data-verdict></b>
        </p>
        <div class="le-actions">
          <button type="button" data-mutate>Mutate</button>
          <button type="button" data-breed>Breed</button>
          <button type="button" class="le-dice" data-dice aria-label="Random specimen">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="4"></rect>
              <circle cx="8" cy="8" r="1.6"></circle>
              <circle cx="16" cy="8" r="1.6"></circle>
              <circle cx="12" cy="12" r="1.6"></circle>
              <circle cx="8" cy="16" r="1.6"></circle>
              <circle cx="16" cy="16" r="1.6"></circle>
            </svg>
          </button>
        </div>
        <p class="le-meta">
          <span class="file" data-file>compiling…</span>
          <span data-gzip></span>
          <span class="muted" data-ms></span>
          <a data-save download="catoid.svg">save .svg</a>
        </p>
      </header>

      <div class="le-bin" role="group" aria-label="Parts">
        {
          parts.map((p) => (
            <div class="le-slot">
              <button type="button" class="le-part" data-part={p.part} aria-label={`Add one of ${p.part}`}>
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <path d={p.d} />
                </svg>
                <output data-count={p.part} />
              </button>
              <button type="button" class="le-less" data-less={p.part} aria-label={`Remove one of ${p.part}`}>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 6h6" />
                </svg>
              </button>
            </div>
          ))
        }
      </div>

      <div class="le-genes">
        {
          rows.map((row) => (
            <div class="le-gene" data-row={row.gene}>
              <span class="le-gene-name">
                {row.label}
              </span>
              <div class="le-options" role="radiogroup" aria-label={row.gene}>
                {row.options.map((o) => (
                  <button type="button" role="radio" data-gene={row.gene} data-value={o.v} title={o.v} aria-label={o.v} set:html={o.html} />
                ))}
              </div>
              {row.scrub.length > 0 && (
                <div class="le-scrubs">
                  {row.scrub.map((gene) => (
                    <button type="button" class="le-scrub" data-scrub={gene} />
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </aside>

    <section class="le-shelf" aria-label="Specimen shelf">
      <ol data-shelf></ol>
    </section>
  </main>
</Base>

<script>
  import "../../lab/e/app.ts";
</script>
