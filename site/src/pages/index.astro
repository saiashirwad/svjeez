---
import { Code } from "astro:components";
import board from "../scenes/board/board.film.tsx?svjeez";
import flowchartTall from "../scenes/flowchart-tall";
import charts from "@examples/charts/index.tsx";
import code from "@examples/code/index.tsx";
import epicycles from "@examples/epicycles/index.tsx";
import globe from "@examples/globe/index.tsx";
import icons from "@examples/icons/index.tsx";
import lanes from "@examples/lanes/index.tsx";
import layout from "@examples/layout/index.tsx";
import math from "@examples/math/index.tsx";
import paint from "@examples/paint/index.tsx";
import readmeBasic from "@examples/readme/basic.tsx";
import readmeLoops from "@examples/readme/loops.tsx";
import sequence from "@examples/sequence/index.tsx";
import state from "@examples/state/index.tsx";
import type from "@examples/type/index.tsx";
import mermaidFlowchart from "@examples/mermaid-types/flowchart.tsx";
import mermaidPie from "@examples/mermaid-types/pie.tsx";
import mermaidRadar from "@examples/mermaid-types/radar.tsx";
import mermaidSequence from "@examples/mermaid-types/sequence.tsx";
import mermaidXychart from "@examples/mermaid-types/xychart.tsx";
import DayNight from "../components/DayNight.astro";
import Hero from "../components/Hero.astro";
import LiveScene from "../components/LiveScene.astro";
import Base from "../layouts/Base.astro";
import { hero, heroFile } from "../hero";
import { live } from "../live";
import { facts, type FileFacts } from "../proof";
import { REPO } from "../links";
import { shikiTheme } from "../styles/code";
import { windowed } from "../window";

// Each slot keeps its window's size, so the page lays out the same whatever scene it holds.
const tile = (scene: Parameters<typeof windowed>[0], title: string) => live(windowed(scene, { size: [504, 340], title }));

const s = {
  board: live(windowed(board, { size: [800], title: "board.film.tsx" })),
  pipeline: live(windowed(mermaidFlowchart, { size: [1032, 300], title: "flowchart.mmd" })),
  pipelineTall: live(windowed(flowchartTall, { size: [358], title: "flowchart.mmd" })),
  handshake: live(windowed(sequence, { size: [1032, 360], title: "sequence.tsx" })),
  handshakeTall: live(windowed(mermaidSequence, { size: [358], title: "sequence.mmd" })),
  explainer: tile(code, "code.tsx"),
  recording: tile(state, "state.tsx"),
  metrics: live(windowed(charts, { size: [960], title: "charts.tsx" })),
  dayNight: live(windowed(layout, { size: [704, 396], title: "layout.tsx" })),
  agents: live(windowed(lanes, { size: [1032, 560], title: "lanes.tsx" })),
  agentsTall: live(windowed(lanes, { size: [358], title: "lanes.tsx" })),
  whereReadme: live(windowed(readmeBasic, { size: [328, 264], title: "README.md", bar: 36 })),
  whereDocs: live(windowed(readmeLoops, { size: [328, 264], title: "Docs", bar: 36 })),
};

const pkg = (name: string) => `${REPO}/tree/main/packages/${name}`;

const reference = (name: string) => `${REPO}/blob/main/packages/svjeez/skills/svjeez/references/${name}.md`;

const tiles = {
  math: [
    {
      name: "math",
      scene: tile(math, "math.tsx"),
      cost: 20,
      label: "Equations",
      from: "@svjeez/math",
      href: pkg("math"),
    },
    {
      name: "epicycles",
      scene: tile(epicycles, "epicycles.tsx"),
      cost: 20,
      label: "Series",
      from: "@svjeez/math",
      href: pkg("math"),
    },
  ],
  data: [
    {
      name: "xychart",
      scene: tile(mermaidXychart, "xychart.mmd"),
      cost: 10,
      label: "Charts",
      from: "@svjeez/mermaid",
      href: pkg("mermaid"),
    },
    {
      name: "pie",
      scene: tile(mermaidPie, "pie.mmd"),
      cost: 10,
      label: "Pie charts",
      from: "@svjeez/mermaid",
      href: pkg("mermaid"),
    },
    {
      name: "radar",
      scene: tile(mermaidRadar, "radar.mmd"),
      cost: 10,
      label: "Radar charts",
      from: "@svjeez/mermaid",
      href: pkg("mermaid"),
    },
  ],
} as const;

const more = [
  {
    name: "icons",
    scene: tile(icons, "icons.tsx"),
    cost: 24,
    label: "8,000 icons",
    from: "@svjeez/icons",
    href: pkg("icons"),
  },
  {
    name: "paint",
    scene: tile(paint, "paint.tsx"),
    cost: 17,
    label: "Paint",
    from: "svjeez",
    href: reference("paint"),
  },
  {
    name: "type",
    scene: tile(type, "type.tsx"),
    cost: 20,
    label: "Google Fonts",
    from: "@svjeez/fonts",
    href: pkg("fonts"),
  },
] as const;

const demo = `// board.film.tsx, next to the app
export default await film(serve({ selector: "#root" }), async ({ page, snap }) => {
  await page.keyboard.press("ControlOrMeta+k");
  await snap("palette", { over: 0.35 });
  await part("query").fill("new iss");
  await snap("narrowed", { over: 0.4 });
  await part("cmd-new-issue").click();
  await snap("dialog", { over: 0.3 });
  await part("title").fill("Save drafts offline");
  await snap("titled", { over: 1.1 });
  await part("create").click();
  await snap("created", { over: 0.6 });
}, { cursor: true });`;

const adaptive = `const theme = tokens({
  light: { background: "#FFFFFF" },
  dark: { background: "#090A0C" },
});

<Shape geometry={canvas.rect}
  fill={theme.background} />`;

const start = `npm i svjeez
npx svjeez dev scene.tsx
npx svjeez check scene.tsx
npx svjeez svg scene.tsx --out scene.svg`;

const geo = live(windowed(globe, { size: [960], title: "globe.tsx" }));

const files = new Map<string, FileFacts>(
  [...Object.values(s), ...tiles.math.map((tile) => tile.scene), ...tiles.data.map((tile) => tile.scene), geo, ...more.map((tile) => tile.scene)].map(
    (scene) => [scene.src, facts(scene)],
  ),
);

files.set(heroFile.src, heroFile);

const total = (field: "gzip" | "script") => [...files.values()].reduce((sum, file) => sum + file[field], 0);
---

<Base
  title="svjeez · write motion in TypeScript, ship it as one SVG"
  description="Write motion in TypeScript. Ship it as one SVG file."
  share={{
    title: "svjeez: write motion in TypeScript, ship it as one SVG",
    description: "Write motion in TypeScript and compile it to one SVG file. No player, no JavaScript.",
  }}
  class="home"
>
  <link slot="head" rel="preload" as="image" href={hero.src} media="(prefers-reduced-motion: no-preference)" />
  <main>
    <Hero />

    <section class="wrap sec g" id="film">
      <h2 class="c1-12 xl"><a class="anchor" href="#film">Film your real app</a></h2>
      <p class="sub c1-8">Script the clicks. <a href={pkg("dom")}>@svjeez/dom</a> turns them into one SVG.</p>
      <figure class="c1-8"><div class="win"><LiveScene scene={s.board} cost={40} name="board" alt={s.board.desc} /></div></figure>
      <Code class="code side c9-12" code={demo} lang="tsx" theme={shikiTheme} />
    </section>

    <div class="tint">
      <section class="wrap sec g" id="explain">
        <h2 class="c1-12 xl"><a class="anchor" href="#explain">Code, diagrams and math that move</a></h2>
        <p class="sub c1-8"><a href={pkg("code")}>Code</a> types itself. <a href={pkg("mermaid")}>Mermaid</a> and <a href={pkg("diagrams")}>diagrams</a> draw in order. <a href={pkg("math")}>Equations</a> rearrange.</p>
        <div class="big c1-12">
          <div class="win">
            <LiveScene class="wide" scene={s.pipeline} cost={44} name="flowchart" alt={s.pipeline.desc} />
            <LiveScene class="tall" scene={s.pipelineTall} cost={30} name="flowchart" alt={s.pipelineTall.desc} />
          </div>
        </div>
        <div class="big c1-12">
          <div class="win">
            <LiveScene class="wide" scene={s.handshake} cost={30} name="sequence" alt={s.handshake.desc} />
            <LiveScene class="tall" scene={s.handshakeTall} cost={30} name="sequence" alt={s.handshakeTall.desc} />
          </div>
        </div>
        <figure class="c1-6"><div class="win"><LiveScene scene={s.explainer} cost={12} name="code" alt={s.explainer.desc} /></div></figure>
        <figure class="c7-12"><div class="win"><LiveScene scene={s.recording} cost={28} name="state" alt={s.recording.desc} /></div></figure>
        <div class="wall c1-12">
          {
            tiles.math.map((tile) => (
              <figure class="tile">
                <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.scene.desc} /></div>
                <figcaption>
                  <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>
    </div>

    <section class="wrap sec g" id="data">
      <h2 class="c1-12 xl"><a class="anchor" href="#data">Charts and maps from your data</a></h2>
      <p class="sub c1-8"><code>svjeez svg scene.tsx --params data.json</code></p>
      <div class="wall c1-12">
        <figure class="tile strip">
          <div class="win"><LiveScene scene={s.metrics} cost={25} name="charts" alt={s.metrics.desc} /></div>
          <figcaption>
            <b>Charts</b> <a href={pkg("charts")}>@svjeez/charts</a>
          </figcaption>
        </figure>
        <figure class="tile strip">
          <div class="win"><LiveScene scene={geo} cost={20} name="globe" alt={geo.desc} /></div>
          <figcaption>
            <b>Maps</b> <a href={pkg("geo")}>@svjeez/geo</a>
          </figcaption>
        </figure>
      </div>
      <div class="wall small c1-12">
        {
          tiles.data.map((tile) => (
            <figure class="tile">
              <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.scene.desc} /></div>
              <figcaption>
                <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="wrap sec g" id="light-dark">
      <h2 class="c1-12"><a class="anchor" href="#light-dark">Light and dark in one file</a></h2>
      <div class="stagewrap c1-8">
        <DayNight scene={s.dayNight} alt={s.dayNight.desc} />
      </div>
      <Code class="code side c9-12" code={adaptive} lang="tsx" theme={shikiTheme} />
    </section>

    <section class="wrap sec g" id="where">
      <h2 class="c1-12"><a class="anchor" href="#where">Plays anywhere an image does</a></h2>
      <p class="sub c1-8">Need a video? <code>svjeez video</code>.</p>
      <figure class="c1-6"><div class="win"><LiveScene scene={s.whereReadme} cost={8} name="readme" bar={36} alt={s.whereReadme.desc} /></div><h3>READMEs</h3></figure>
      <figure class="c7-12"><div class="win"><LiveScene scene={s.whereDocs} cost={4} name="docs" bar={36} alt={s.whereDocs.desc} /></div><h3>Docs and blogs</h3></figure>
    </section>

    <div class="tint">
      <section class="wrap sec g" id="agents">
        <h2 class="c1-12"><a class="anchor" href="#agents">Your agent can write it</a></h2>
        <p class="sub c1-8"><code>npx svjeez skill --install</code></p>
        <div class="big c1-12">
          <div class="win desk">
            <LiveScene class="wide" scene={s.agents} cost={52} name="agents" alt={s.agents.desc} />
            <LiveScene class="tall" scene={s.agentsTall} cost={40} name="agents" alt={s.agentsTall.desc} />
          </div>
        </div>
      </section>
    </div>

    <section class="wrap sec g" id="more">
      <h2 class="c1-12"><a class="anchor" href="#more">And more</a></h2>
      <div class="wall small c1-12">
        {
          more.map((tile) => (
            <figure class="tile">
              <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.scene.desc} /></div>
              <figcaption>
                <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="wrap close" id="start">
      <h2><a class="anchor" href="#start">Get started</a></h2>
      <p class="tally">This page: <b>{files.size}</b> SVGs, <b>{Math.round(total("gzip") / 1024)} KB</b> gzipped, <b>{total("script")}</b> bytes of JavaScript.</p>
      <div class="ways">
        <div class="way">
          <h3>By hand</h3>
          <pre class="code">{start}</pre>
          <p>Plugs into <a href={pkg("vite")}>Vite</a> and <a href={pkg("astro")}>Astro</a>.</p>
        </div>
        <div class="way">
          <h3>With your agent</h3>
          <pre class="code">npx svjeez skill --install</pre>
        </div>
      </div>
      <p class="more"><a class="btn primary" href={`${REPO}/tree/main/examples`}>See examples</a><a class="btn" href={REPO}>GitHub</a></p>
      <aside class="fine" id="fine-print" aria-labelledby="fine-print-title">
        <h3 id="fine-print-title">Requirements</h3>
        <ul>
          <li>Node 22+ or Bun. On Node, install <code>tsx</code>.</li>
          <li>Filming and frames need <code>playwright-core</code> and Chromium.</li>
                  </ul>
      </aside>
    </section>
  </main>

  <footer class="wrap foot">
    <p>MIT licensed.</p>
    <nav aria-label="Footer"><a href={`${REPO}/tree/main/examples`}>Examples</a><a href={REPO}>GitHub</a><a href="https://www.npmjs.com/package/svjeez">npm</a></nav>
  </footer>
</Base>
