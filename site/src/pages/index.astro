---
import { Code } from "astro:components";
import agents from "@examples/site/agents.tsx";
import agentsTall from "@examples/site/agents-tall.tsx";
import dayNight from "@examples/site/day-night.tsx";
import charts from "@examples/site/charts.tsx";
import chartsArea from "@examples/site/charts-area.tsx";
import chartsLines from "@examples/site/charts-lines.tsx";
import explainer from "@examples/site/explainer.tsx";
import fonts from "@examples/site/fonts.tsx";
import geo from "@examples/site/geo.tsx";
import handshake from "@examples/site/handshake.tsx";
import handshakeTall from "@examples/site/handshake-tall.tsx";
import icons from "@examples/site/icons.tsx";
import ink from "@examples/site/ink.tsx";
import math from "@examples/site/math.tsx";
import mathFourier from "@examples/site/math-fourier.tsx";
import nojsxTall from "@examples/site/nojsx-tall.tsx";
import pipeline from "@examples/site/pipeline.tsx";
import pipelineTall from "@examples/site/pipeline-tall.tsx";
import recording from "@examples/site/recording.tsx";
import timeline from "@examples/site/timeline.tsx";
import timelineTall from "@examples/site/timeline-tall.tsx";
import whereDocs from "@examples/site/where-docs.tsx";
import whereReadme from "@examples/site/where-readme.tsx";
import metrics from "@examples/metrics/index.tsx";
import board from "@examples/board/index.tsx";
import DayNight from "../components/DayNight.astro";
import Hero from "../components/Hero.astro";
import LiveScene from "../components/LiveScene.astro";
import Base from "../layouts/Base.astro";
import { hero, heroFile } from "../hero";
import { live } from "../live";
import Editor from "../landing/Editor.svelte";
import { first } from "../landing/first";
import { facts, type FileFacts } from "../proof";
import { REPO } from "../examples";
import { shikiTheme } from "../styles/code";

const s = {
  board: live(board),
  timeline: live(timeline),
  timelineTall: live(timelineTall),
  pipeline: live(pipeline),
  pipelineTall: live(pipelineTall),
  handshake: live(handshake),
  handshakeTall: live(handshakeTall),
  explainer: live(explainer),
  recording: live(recording),
  metrics: live(metrics),
  dayNight: live(dayNight),
  agents: live(agents),
  agentsTall: live(agentsTall),
  whereReadme: live(whereReadme),
  whereDocs: live(whereDocs),
};

const pkg = (name: string) => `${REPO}/tree/main/packages/${name}`;

const reference = (name: string) => `${REPO}/blob/main/packages/svjeez/skills/svjeez/references/${name}.md`;

const tiles = {
  math: [
    {
      name: "euler",
      scene: live(math),
      cost: 20,
      label: "Equations",
      from: "@svjeez/math",
      href: pkg("math"),
      alt: "A point turns once round the unit circle while its cosine and sine trace the axes. Euler's formula, e to the i theta equals cos theta plus i sin theta, follows it to pi, collapses to e to the i pi equals minus one, and settles as e to the i pi plus one equals zero.",
    },
    {
      name: "fourier",
      scene: live(mathFourier),
      cost: 20,
      label: "Series",
      from: "@svjeez/math",
      href: pkg("math"),
      alt: "A chain of circles builds a square wave. A large blue circle spins, and a faint line carries its tip's height to a plot on the right, where a yellow pen traces a sine wave over a dashed square wave. Smaller green, orange and purple circles join one at a time, each spinning faster on the tip of the last, and each new trace comes closer to the square while older traces fade behind it. Above, the formula gains one term per circle, each term the color of its circle.",
    },
  ],
  data: [
    {
      name: "chart",
      scene: live(charts),
      cost: 10,
      label: "Charts",
      from: "@svjeez/charts",
      href: pkg("charts"),
      alt: "Six bars grow up from the baseline one month at a time, then an orange line draws across the chart and its dots pop in as the stroke reaches them.",
    },
    {
      name: "lines",
      scene: live(chartsLines),
      cost: 10,
      label: "Line charts",
      from: "@svjeez/charts",
      href: pkg("charts"),
      alt: "Build minutes over eight releases. A green monotone line for linux draws first, then a blue straight-segment line for macos, then an orange step line for windows, and each writes its name past its last point. All three fall release by release.",
    },
    {
      name: "map",
      scene: live(geo),
      cost: 20,
      label: "Maps",
      from: "@svjeez/geo",
      href: pkg("geo"),
      alt: "The world's countries fill in from west to east. Great-circle routes then arc out of London to New York, São Paulo, Lagos, Mumbai, Singapore and Tokyo, and each city is labelled as its flight lands.",
    },
    {
      name: "area",
      scene: live(chartsArea),
      cost: 10,
      label: "Area charts",
      from: "@svjeez/charts",
      href: pkg("charts"),
      alt: "An orange area of median review hours wipes on from week 1 to week 12, its dots popping in as the line reaches them. A dashed line then marks week 8, where a review bot ships and the hours fall from about 26 to 7.",
    },
  ],
} as const;

const more = [
  {
    name: "icons",
    scene: live(icons),
    cost: 24,
    label: "8,000 icons",
    from: "@svjeez/icons",
    href: pkg("icons"),
    alt: "Eight icons arrive in eight ways: a rocket draws on, a heart pops, a box drops, a gear spins in, an eye comes into focus, wifi bars cascade, a sun swaps for a moon and a bell rings.",
  },
  {
    name: "ink",
    scene: live(ink),
    cost: 17,
    label: "Handwriting",
    from: "svjeez",
    href: reference("ink"),
    alt: "The word hello is handwritten stroke by stroke, then a brush swash is inked underneath.",
  },
  {
    name: "fonts",
    scene: live(fonts),
    cost: 20,
    label: "Your fonts",
    from: "@svjeez/fonts",
    href: pkg("fonts"),
    alt: "The words Aa Type draw on as outlines in an embedded display font, with real italic text below.",
  },
  {
    name: "no-jsx",
    scene: live(nojsxTall),
    cost: 30,
    label: "No JSX",
    from: "svjeez",
    href: reference("without-jsx"),
    alt: "A scene written with jsx() calls, lit block by block, beside a preview where an arc draws and a dot pops onto it.",
  },
] as const;

const demo = `// board.demo.tsx, next to the app
export const board = demo(Board, layout, () => [
  press("ControlOrMeta+k"),
  snap("palette", { over: 0.35 }),
  fill("query", "new iss"),
  snap("narrowed", { over: 0.4 }),
  click("cmd-new-issue"),
  snap("dialog", { over: 0.3 }),
  fill("title", "Save drafts offline"),
  snap("titled", { over: 1.1 }),
  click("create"),
  snap("created", { over: 0.6 }),
  ...drag("ENG-143", "progress"),
]);`;

const adaptive = `const { theme, css } = adaptive({
  dark: systemDark,
  light: systemLight,
});

render({ css },
  <rect fill={theme.base00} />,
);`;

const start = `npm i svjeez
npx svjeez dev scene.tsx
npx svjeez check scene.tsx
npx svjeez svg scene.tsx --out scene.svg`;

const files = new Map<string, FileFacts>(
  [...Object.values(s), ...tiles.math.map((tile) => tile.scene), ...tiles.data.map((tile) => tile.scene), ...more.map((tile) => tile.scene)].map(
    (scene) => [scene.src, facts(scene)],
  ),
);

files.set(heroFile.src, heroFile);

const total = (field: "gzip" | "script") => [...files.values()].reduce((sum, file) => sum + file[field], 0);
---

<Base
  title="svjeez · write motion in TypeScript, ship it as one SVG"
  description="Write motion in TypeScript. Ship it as one SVG file, with no player and no runtime JavaScript. It plays wherever an <img> does."
  share={{
    title: "svjeez: write motion in TypeScript, ship it as one SVG",
    description: "Write motion in TypeScript and compile it to one SVG file. No player, no JavaScript.",
    alt: "A line-drawn flower and the TSX that makes it.",
  }}
  class="home"
>
  <link slot="head" rel="preload" as="image" href={hero.src} media="(prefers-reduced-motion: no-preference)" />
  <main>
    <Hero />

    <section class="wrap sec g" id="film">
      <h2 class="c1-8 xl"><a class="anchor" href="#film">Film your real components.</a></h2>
      <p class="sub c1-8">A real React app, recorded by <a href={pkg("dom")}>@svjeez/dom</a>.</p>
      <figure class="c1-8"><div class="win"><LiveScene scene={s.board} cost={40} name="board" bar={0} alt="A project board, filmed from its React demo. A command palette opens and narrows to New issue as it is typed into, then turns into a dialog where a title is typed and a label and assignee are picked. The new card lands in Todo, is dragged to In progress and marked done, while the counts, the cycle's progress and the sidebar update and a toast confirms." /></div></figure>
      <Code class="code side c9-12" code={demo} lang="tsx" theme={shikiTheme} />
    </section>

    <section class="wrap sec g" id="play">
      <h2 class="c1-8"><a class="anchor" href="#play">Change a number, watch it move.</a></h2>
      <p class="sub c1-8">Every value has a control. Drag one.</p>
      <div class="c1-12">
        <Editor client:visible first={first} />
        <p class="playlink"><a href="/play">Open the playground</a></p>
      </div>
      <div class="big c1-12">
        <div class="win">
          <LiveScene class="wide" scene={s.timeline} cost={41} name="timeline" alt="A motion chain in an editor, lit line by line. The same chain is drawn as one track per channel with a playhead sweeping across, while a square fades in, drops into place, grows and turns orange as the chain says." />
          <LiveScene class="tall" scene={s.timelineTall} cost={30} name="timeline" alt="A motion chain in an editor, lit line by line. The same chain is drawn as one track per channel with a playhead sweeping across, while a square fades in, drops into place, grows and turns orange as the chain says." />
        </div>
      </div>
    </section>

    <div class="tint">
      <section class="wrap sec g" id="explain">
        <h2 class="c1-8 xl"><a class="anchor" href="#explain">Explain code, diagrams and math on one timeline.</a></h2>
        <p class="sub c1-8"><a href={pkg("code")}>Code</a>, <a href={pkg("diagrams")}>diagrams</a>, <a href={pkg("mermaid")}>Mermaid</a> and <a href={pkg("math")}>TeX</a>, on one clock.</p>
        <div class="big c1-12">
          <div class="win">
            <LiveScene class="wide" scene={s.pipeline} cost={44} name="pipeline" alt="A flowchart from prompt to finished SVG. Blip hops along it, is puzzled at Frames ok? the first time, walks the no line back, then says yes and reaches the SVG." />
            <LiveScene class="tall" scene={s.pipelineTall} cost={30} name="pipeline" alt="A flowchart from prompt to finished SVG. Blip hops along it, is puzzled at Frames ok? the first time, walks the no line back, then says yes and reaches the SVG." />
          </div>
        </div>
        <div class="big c1-12">
          <div class="win">
            <LiveScene class="wide" scene={s.handshake} cost={30} name="sequence" alt="A sequence diagram plays while Blip acts it out: it opens a README, asks a sleepy CDN cloud for hello.svg, catches the file, watches it play and cheers." />
            <LiveScene class="tall" scene={s.handshakeTall} cost={30} name="sequence" alt="A sequence diagram plays while Blip acts it out: it opens a README, asks a sleepy CDN cloud for hello.svg, catches the file, watches it play and cheers." />
          </div>
        </div>
        <figure class="c1-6"><div class="win"><LiveScene scene={s.explainer} cost={23} name="explainer" alt="Five lines of TSX with a spotlight moving across them and a note explaining draw and enter." /></div></figure>
        <figure class="c7-12"><div class="win"><LiveScene scene={s.recording} cost={28} name="terminal" alt="Three svjeez commands in a terminal: frames, svg and skill, each followed by its output." /></div></figure>
        <div class="wall c1-12">
          {
            tiles.math.map((tile) => (
              <figure class="tile">
                <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.alt} /></div>
                <figcaption>
                  <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>
    </div>

    <section class="wrap sec g" id="data">
      <h2 class="c1-8 xl"><a class="anchor" href="#data">Draw from your data.</a></h2>
      <p class="sub c1-8">One scene, new numbers: <code>svjeez svg scene.tsx --params data.json</code></p>
      <div class="wall c1-12">
        <figure class="tile strip">
          <div class="win"><LiveScene scene={s.metrics} cost={25} name="metrics" bar={0} alt="Four KPI tiles count up to their figures, then a bar chart of eight weeks of signups grows in." /></div>
          <figcaption>
            <b>Templates</b> <a href={reference("params")}>svjeez/params</a>
          </figcaption>
        </figure>
        {
          tiles.data.map((tile) => (
            <figure class="tile">
              <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.alt} /></div>
              <figcaption>
                <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="wrap sec g" id="light-dark">
      <h2 class="c1-8"><a class="anchor" href="#light-dark">One file, light and dark.</a></h2>
      <div class="stagewrap c1-8">
        <DayNight scene={s.dayNight} alt="Blip by day and by night, from one file. In light it bounces beside an open flower under the sun while a butterfly loops around. In dark it sleeps under the moon with its bulb as a night-light, Zs drifting up, the flower closed and fireflies blinking." />
      </div>
      <Code class="code side c9-12" code={adaptive} lang="tsx" theme={shikiTheme} />
    </section>

    <section class="wrap sec g" id="where">
      <h2 class="c1-8"><a class="anchor" href="#where">It plays wherever an image does.</a></h2>
      <p class="sub c1-8">READMEs, docs, any web page. <code>svjeez video</code> for the rest.</p>
      <figure class="c1-6"><div class="win"><LiveScene scene={s.whereReadme} cost={8} name="readme" bar={36} alt="A README page with an animated dot-matrix image in the middle." /></div><h3>READMEs</h3></figure>
      <figure class="c7-12"><div class="win"><LiveScene scene={s.whereDocs} cost={4} name="docs" bar={36} alt="A docs page with a diagram in which a packet travels between two boxes." /></div><h3>Docs and blogs</h3></figure>
    </section>

    <div class="tint">
      <section class="wrap sec g" id="agents">
        <h2 class="c1-8"><a class="anchor" href="#agents">Your agent can write these.</a></h2>
        <p class="sub c1-8"><code>npx svjeez skill --install</code></p>
        <div class="big c1-12">
          <div class="win desk">
            <LiveScene class="wide" scene={s.agents} cost={52} name="agents" bar={0} alt="On a desktop, a terminal installs the svjeez skill. Beside it an agent reads the skill, writes a scene, renders frames, checks them and reports the result, and a small spinner it made turns." />
            <LiveScene class="tall" scene={s.agentsTall} cost={40} name="agents" bar={0} alt="On a desktop, a terminal installs the svjeez skill. Beside it an agent reads the skill, writes a scene, renders frames, checks them and reports the result, and a small spinner it made turns." />
          </div>
        </div>
      </section>
    </div>

    <section class="wrap sec g" id="more">
      <h2 class="c1-8"><a class="anchor" href="#more">Also in the box.</a></h2>
      <div class="wall small c1-12">
        {
          more.map((tile) => (
            <figure class="tile">
              <div class="win"><LiveScene scene={tile.scene} cost={tile.cost} name={tile.name} alt={tile.alt} /></div>
              <figcaption>
                <b>{tile.label}</b> <a href={tile.href}>{tile.from}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="wrap close" id="start">
      <h2><a class="anchor" href="#start">Everything you just watched was an <code>&lt;img&gt;</code>.</a></h2>
      <p class="tally"><b>{files.size}</b> SVG files, <b>{Math.round(total("gzip") / 1024)} KB</b> gzipped, <b>{total("script")}</b> bytes of JavaScript.</p>
      <div class="ways">
        <div class="way">
          <h3>Start yourself</h3>
          <pre class="code">{start}</pre>
          <p>Also: <a href={pkg("vite")}>Vite</a>, <a href={pkg("astro")}>Astro</a>, <a href={pkg("video")}>video</a>.</p>
        </div>
        <div class="way">
          <h3>Or hand it to your agent</h3>
          <pre class="code">npx svjeez skill --install</pre>
                  </div>
      </div>
      <p class="more"><a class="btn primary" href="/examples/">Explore the examples</a><a class="btn" href="/intro">Watch the one-minute intro</a></p>
      <aside class="fine" id="fine-print" aria-labelledby="fine-print-title">
        <h3 id="fine-print-title">The fine print</h3>
        <ul>
          <li>Node 20+ or Bun. On Node, install <code>tsx</code>.</li>
          <li>Frames need <code>playwright-core</code> and Chromium.</li>
          <li>Fonts and images are embedded in the file.</li>
        </ul>
      </aside>
    </section>
  </main>

  <footer class="wrap foot">
    <p>MIT licensed.</p>
    <nav aria-label="Footer"><a href="/examples/">Examples</a><a href="/intro">Intro</a><a href={REPO}>GitHub</a><a href="https://www.npmjs.com/package/svjeez">npm</a></nav>
  </footer>
</Base>
