---
import { POSTER_WIDTH, SMALL_POSTER_WIDTH, examples, SOURCES, type Span } from "../../examples";
import { themed } from "../../palettes";
import { cueImage } from "../../hero";
import { kb } from "../../proof";
import Base from "../../layouts/Base.astro";
import LiveScene from "../../components/LiveScene.astro";
import Proof from "../../components/Proof.astro";
import { getScene } from "@svjeez/astro/scene";
import yourAgent from "@examples/site/your-agent.tsx";
import { note } from "@examples/site/gallery-note.tsx";

/** "your agent", handwritten by a scene and inlined so it takes the accent color. */
const { svg: handwriting } = getScene(yourAgent);

/** The lead's size, handwritten over the card beside it and pointing back. Measured here, so it is always true. */
const [lead] = examples;
const { svg: sizeNote } = getScene(() => note(kb(lead!.scene.gzip)));

/** The cards in the first row, which load at once at high priority; the second row loads at once too. */
const FIRST_ROW = 2;
const ABOVE_FOLD = 5;

/** How wide a card draws, for the browser to pick a poster by: its columns of 66rem from 56rem, two up from 40rem. */
const WIDTH: Record<Span, string> = { 4: "21rem", 5: "27rem", 6: "32rem", 7: "38rem" };

const sizes = (span: Span, i: number) =>
  `(min-width: 56rem) ${WIDTH[span]}, (min-width: 40rem) ${i === 0 ? "100vw" : "50vw"}, 100vw`;

/** Fetch an example's page when the pointer rests on its link. The page is tiny; its SVG loads once you are there. */
const speculation = JSON.stringify({ prefetch: [{ source: "document", where: { href_matches: "/examples/*" }, eagerness: "moderate" }] });
---

<Base title="Examples · svjeez" description="Explore animated scenes and building blocks made with svjeez. Each is a self-contained SVG." class="gallery" current="examples" card="examples">
  <script slot="head" type="speculationrules" is:inline set:html={speculation} />
  <main class="wrap">
    <div class="page-head">
      <h1>
        Explore what <span class="edit"><s>you</s><svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M-4 25C14 17 30 29 50 21S86 24 104 15M2 31C24 24 52 33 98 23" /></svg><ins><span>your agent</span><span aria-hidden="true" set:html={handwriting} /></ins></span> can make.
      </h1>
    </div>
    <div class="grid">
      {examples.map(({ name, span, scene, small }, i) => {
              const loading = i < FIRST_ROW ? { fetchpriority: "high" } as const : i < ABOVE_FOLD ? {} : { loading: "lazy" } as const;
              const SIZES = sizes(span, i);
              const set = (scheme: "light" | "dark") => `${small.posters![scheme]} ${SMALL_POSTER_WIDTH}w, ${scene.posters![scheme]} ${POSTER_WIDTH}w`;

              return (
                <div class="card" style={`--span: ${span}`}>
                  <span
                    class="shot"
                    data-live={scene.src}
                    data-light={scene.posters!.light}
                    data-dark={scene.posters!.dark}
                    data-light-small={small.posters!.light}
                    data-dark-small={small.posters!.dark}
                  >
                    <picture>
                      <source media="(prefers-color-scheme: dark)" srcset={set("dark")} sizes={SIZES} />
                      <img
                        src={small.posters!.light}
                        srcset={set("light")}
                        sizes={SIZES}
                        width={POSTER_WIDTH}
                        height={Math.round((POSTER_WIDTH * scene.height) / scene.width)}
                        alt=""
                        decoding="async"
                        {...loading}
                        data-themed={themed(scene.svg) ? "" : undefined}
                      />
                    </picture>
                  </span>
                  <span class="cap"><a class="title" href={`/examples/${name}`}>{scene.title}</a>{"\u2060"}<Proof scene={scene} name={name} alt={scene.desc || scene.title} /></span>
                </div>
              );
            })}
      <span class="note" aria-hidden="true"><span set:html={sizeNote} /></span>
    </div>
    <a class="end" href="/play" aria-label="Play with svjeez"><LiveScene class="cue" scene={cueImage} cost={6} alt="" /></a>
  </main>
  <footer class="wrap foot">
    <span>Find the source for every scene on GitHub.</span>
    <nav aria-label="Footer"><a href={SOURCES}>All sources</a><a href="/">Home</a></nav>
  </footer>
</Base>

<script>
  import { DEFAULT_PALETTE } from "../../palettes";
  import { type Frame, frozen, palette, PALETTECHANGE, playing, replay, show } from "../../scripts/palette";
  import { calm, scheme, THEMECHANGE } from "../../scripts/scheme";

  // A card shows a still until you hover it (or, on a touch screen, until it is mostly in view).
  // Only then does its SVG download, and it goes back to the still when you leave.
  // The still is in the HTML, a lazy <picture> the browser sizes and fetches by itself. This script takes the card over
  // (drops the srcset) only to swap it: to play, to rest, or when the scheme or palette is not the one the HTML shows.
  const shots = document.querySelectorAll<HTMLElement>(".shot[data-live]");
  const image = (shot: HTMLElement) => shot.querySelector("img")!;
  const systemScheme = () => (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

  /** The smallest poster that is sharp at the card's size and this screen. */
  const posterOf = (shot: HTMLElement) => {
    const wide = shot.clientWidth * devicePixelRatio > 600;
    // SAFETY: scheme() is "light" or "dark", and the suffix is "" or "Small", so the key is one of these four.
    const key = `${scheme()}${wide ? "" : "Small"}` as "light" | "dark" | "lightSmall" | "darkSmall";

    return shot.dataset[key]!;
  };

  const stillOf = (shot: HTMLElement) => frozen(image(shot), shot.dataset.live!, posterOf(shot));

  /** What the card's still was made for: the scheme, and the palette when the scene follows one. */
  const keyOf = (shot: HTMLElement) => (image(shot).dataset.themed === undefined ? scheme() : `${scheme()} ${palette()}`);

  /** Show `next` in the card, and with it let go of the HTML's srcset, which would win over the new src. */
  const swap = async (shot: HTMLElement, next: Promise<Frame>, options?: { fade?: boolean }) => {
    const img = image(shot);
    const shown = await show(img, next, options);

    if (shown) {
      img.removeAttribute("srcset");
      shot.querySelectorAll("source").forEach((source) => source.remove());
    }

    return shown;
  };

  /** Show the still for the current scheme and palette. */
  const still = (shot: HTMLElement, fade = false) => {
    shot.dataset.key = keyOf(shot);

    return swap(shot, stillOf(shot), { fade });
  };

  const run = (shot: HTMLElement) => {
    if (shot.dataset.want === "1" || calm.matches) return;
    shot.dataset.want = "1";
    delete shot.dataset.key;
    swap(shot, playing(image(shot), shot.dataset.live!), { fade: true }).then((shown) => shown && (shot.dataset.playing = "1"));
  };

  const rest = (shot: HTMLElement) => {
    if (shot.dataset.want !== "1") return;
    shot.dataset.want = "0";
    delete shot.dataset.playing;
    still(shot, true);
  };

  if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let timer: ReturnType<typeof setTimeout>;

    for (const shot of shots) {
      const card = shot.closest(".card")!;
      const link = card.querySelector("a.title")!;
      const proof = card.querySelector<HTMLElement>(".proof")!;
      const later = () => (clearTimeout(timer), (timer = setTimeout(() => run(shot), 150)));

      // The size chip and its menu belong to the card but are not a way into the scene, so pointing at them never starts it.
      card.addEventListener("pointerenter", later);
      card.addEventListener("pointerleave", () => (clearTimeout(timer), rest(shot)));
      proof.addEventListener("pointerenter", () => clearTimeout(timer));
      proof.addEventListener("pointerleave", (event) => {
        const to = event.relatedTarget;

        if (to instanceof Node && card.contains(to) && !proof.contains(to)) later();
      });
      link.addEventListener("focus", () => run(shot));
      link.addEventListener("blur", () => rest(shot));
    }
  } else {
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;

          if (entry.isIntersecting) run(entry.target);
          else rest(entry.target);
        }),
      { threshold: 0.75 },
    );

    shots.forEach((shot) => seen.observe(shot));
  }

  // The HTML shows the system's scheme and the default palette. A card near the screen gets its still redone when the
  // reader's choice differs, and a card far from it waits until it comes near, so a change costs only what is in view.
  for (const shot of shots) shot.dataset.key = image(shot).dataset.themed === undefined ? systemScheme() : `${systemScheme()} ${DEFAULT_PALETTE}`;

  const near = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!(entry.target instanceof HTMLElement)) return;
        const shot = entry.target;

        if (!entry.isIntersecting) return void delete shot.dataset.near;
        shot.dataset.near = "";

        if (shot.dataset.want !== "1" && shot.dataset.key !== keyOf(shot)) still(shot);
      }),
    { rootMargin: "250px 0px" },
  );

  shots.forEach((shot) => near.observe(shot));

  const restill = (fade: boolean) =>
    shots.forEach((shot) => {
      if (shot.dataset.want === "1") return;

      if (shot.dataset.near !== undefined && shot.dataset.key !== keyOf(shot)) still(shot, fade);
    });

  addEventListener(THEMECHANGE, () => restill(false));

  addEventListener(PALETTECHANGE, () => {
    shots.forEach((shot) => {
      if (shot.dataset.playing) replay(image(shot));
      else if (shot.dataset.want === "1") {
        delete shot.dataset.want;
        run(shot);
      }
    });
    restill(true);
  });
</script>
