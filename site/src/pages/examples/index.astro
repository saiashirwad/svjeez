---
import { examples, SOURCES, type Span } from "../../examples";
import { themed } from "../../palettes";
import { kb } from "../../proof";
import Base from "../../layouts/Base.astro";
import Proof from "../../components/Proof.astro";
import Scene from "@svjeez/astro/Scene.astro";
import { inline } from "../../inline";
import yourAgent from "../../scenes/your-agent";
import { note } from "../../scenes/gallery-note";

/** "your agent", handwritten by a scene, so it takes the accent color. */
const handwriting = inline(yourAgent, "ya");

/** The lead's size, handwritten over the card beside it and pointing back. Measured here, so it is always true. */
const [lead] = examples;
const sizeNote = inline(note(kb(lead!.scene.gzip)), "gn");

/** The cards in the first row, which load at once at high priority; the second row loads at once too. */
const FIRST_ROW = 2;
const ABOVE_FOLD = 5;

/** How wide a card draws, for the browser to pick a poster by: its columns of 66rem from 56rem, two up from 40rem. */
const WIDTH: Record<Span, string> = { 4: "21rem", 5: "27rem", 6: "32rem", 7: "38rem" };

const sizes = (span: Span, i: number) =>
  `(min-width: 56rem) ${WIDTH[span]}, (min-width: 40rem) ${i === 0 ? "100vw" : "50vw"}, 100vw`;

---

<Base title="Examples · svjeez" description="Animated scenes made with svjeez. Each one is a single SVG file." class="gallery" current="examples">
  <main class="wrap">
    <div class="page-head">
      <h1>
        Explore what <span class="edit"><s>you</s><svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M-4 25C14 17 30 29 50 21S86 24 104 15M2 31C24 24 52 33 98 23" /></svg><ins><span>your agent</span><span aria-hidden="true" set:html={handwriting} /></ins></span> can make.
      </h1>
    </div>
    <div class="grid">
      {examples.map(({ name, span, scene }, i) => {
        const loading = i < FIRST_ROW ? { fetchpriority: "high" } as const : i < ABOVE_FOLD ? {} : { loading: "lazy" } as const;

        return (
          <div class="card" style={`--span: ${span}`}>
            <span class="shot">
              <Scene scene={scene} alt="" poster={{ sizes: sizes(span, i) }} data-themed={themed(scene.svg) ? "" : undefined} {...loading} />
            </span>
            <span class="cap"><a class="title" href={`/examples/${name}`} data-astro-prefetch>{scene.title}</a>{"\u2060"}<Proof scene={scene} name={name} alt={scene.desc || scene.title} /></span>
          </div>
        );
      })}
      <span class="note" aria-hidden="true"><span set:html={sizeNote} /></span>
    </div>
  </main>
  <footer class="wrap foot">
    <nav aria-label="Footer"><a href={SOURCES}>All sources</a><a href="/">Home</a></nav>
  </footer>
</Base>

<script>
  import { hovered, player, seen } from "svjeez/page";
  import { look } from "../../scripts/look";
  import { PALETTECHANGE } from "../../scripts/palette";
  import { THEMECHANGE } from "../../scripts/scheme";

  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;

  const players = [...document.querySelectorAll<HTMLImageElement>(".shot img[data-svjeez]")].map((img) => {
    const card = img.closest(".card")!;
    const scene = player(img, { look, near: 250 });

    (fine
      ? hovered(card, { ignore: card.querySelector<HTMLElement>(".proof")!, focus: card.querySelector<HTMLElement>("a.title")! })
      : seen())(scene);

    return scene;
  });

  addEventListener(THEMECHANGE, () => players.forEach((scene) => scene.refresh()));

  addEventListener(PALETTECHANGE, () => players.forEach((scene) => scene.refresh({ fade: true })));
</script>
