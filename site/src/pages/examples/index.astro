---
import { POSTER_WIDTH, sections, SOURCES } from "../../examples";
import { themed } from "../../palettes";
import Base from "../../layouts/Base.astro";

/** Fetch an example's page when the pointer rests on its link. The page is tiny; its SVG loads once you are there. */
const speculation = JSON.stringify({ prefetch: [{ source: "document", where: { href_matches: "/examples/*" }, eagerness: "moderate" }] });
---

<Base title="Examples · svjeez" description="Explore animated scenes and building blocks made with svjeez. Each is a self-contained SVG." class="gallery" current="examples">
  <script slot="head" type="speculationrules" is:inline set:html={speculation} />
  <main class="wrap">
    <div class="page-head">
      <p class="kicker">Examples</p>
      <h1>Explore what you can make.</h1>
      <p class="sub">Each example is a single animated SVG made with svjeez. Hover over a card to play it; on touch screens, scenes play as you scroll. Open one to see it full size and find its source.</p>
    </div>
    {
      sections.map((section) => (
        <section>
          <h2>
            {section.title}
            <small>{section.blurb}</small>
          </h2>
          <div class="grid">
            {section.examples.map(({ name, scene }) => (
              <a class="card" href={`/examples/${name}`}>
                <span class="shot" data-live={scene.src} data-light={scene.posters!.light} data-dark={scene.posters!.dark}>
                  <img width={POSTER_WIDTH} height={Math.round((POSTER_WIDTH * scene.height) / scene.width)} alt="" decoding="async" data-themed={themed(scene.svg) ? "" : undefined} />
                </span>
                <span>
                  <b>{scene.title}</b>
                  <span class="d">{scene.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>
  <footer class="wrap foot">
    <span>Find the source for every scene on GitHub.</span>
    <nav aria-label="Footer"><a href={SOURCES}>All sources</a><a href="/">Home</a></nav>
  </footer>
</Base>

<script>
  import { frozen, PALETTECHANGE, playing, replay, show } from "../../scripts/palette";
  import { calm, scheme, THEMECHANGE } from "../../scripts/scheme";

  // A card shows a still until you hover it (or, on a touch screen, until it is mostly in view).
  // Only then does its SVG download, and it goes back to the still when you leave.
  const shots = document.querySelectorAll<HTMLElement>(".shot[data-live]");
  const image = (shot: HTMLElement) => shot.querySelector("img")!;
  const stillOf = (shot: HTMLElement) => frozen(image(shot), shot.dataset.live!, shot.dataset[scheme()]!);

  const run = (shot: HTMLElement) => {
    if (shot.dataset.want === "1" || calm.matches) return;
    shot.dataset.want = "1";
    show(image(shot), playing(image(shot), shot.dataset.live!)).then((shown) => shown && (shot.dataset.playing = "1"));
  };

  const rest = (shot: HTMLElement) => {
    if (shot.dataset.want !== "1") return;
    shot.dataset.want = "0";
    delete shot.dataset.playing;
    show(image(shot), stillOf(shot));
  };

  if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let timer: ReturnType<typeof setTimeout>;

    for (const shot of shots) {
      const card = shot.closest("a")!;
      card.addEventListener("pointerenter", () => (timer = setTimeout(() => run(shot), 150)));
      card.addEventListener("pointerleave", () => (clearTimeout(timer), rest(shot)));
      card.addEventListener("focus", () => run(shot));
      card.addEventListener("blur", () => rest(shot));
    }
  } else {
    const seen = new IntersectionObserver((entries) => entries.forEach((entry) => (entry.isIntersecting ? run : rest)(entry.target as HTMLElement)), { threshold: 0.75 });
    shots.forEach((shot) => seen.observe(shot));
  }

  const near = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const shot = entry.target as HTMLElement;

        if (!shot.dataset.want) show(image(shot), stillOf(shot));
        near.unobserve(shot);
      }),
    { rootMargin: "250px 0px" },
  );

  shots.forEach((shot) => near.observe(shot));

  // A recolored still follows light and dark by itself; a poster has to be swapped.
  addEventListener(THEMECHANGE, () => shots.forEach((shot) => !shot.dataset.playing && image(shot).src && !image(shot).src.startsWith("blob:") && show(image(shot), stillOf(shot))));

  addEventListener(PALETTECHANGE, () =>
    shots.forEach((shot) => {
      if (shot.dataset.playing) replay(image(shot));
      else if (shot.dataset.want === "1") (delete shot.dataset.want, run(shot));
      else if (image(shot).src) show(image(shot), stillOf(shot), { fade: true });
    }),
  );
</script>
