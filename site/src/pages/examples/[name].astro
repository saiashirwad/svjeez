---
import type { GetStaticPaths } from "astro";
import { examples, REPO, SOURCES } from "../../examples";
import Base from "../../layouts/Base.astro";
import { themed } from "../../palettes";

export const getStaticPaths = (() => examples.map((example, i) => ({ params: { name: example.name }, props: { i } }))) satisfies GetStaticPaths;

const { i } = Astro.props;
const { name, scene } = examples[i]!;
const prev = examples[(i - 1 + examples.length) % examples.length]!;
const next = examples[(i + 1) % examples.length]!;
const { light, dark } = scene.posters!;
---

<Base title={`${scene.title} · svjeez`} description={scene.desc || `${scene.title}, made with svjeez`} class="viewer" current="examples">
  <main class="wrap" style={`--ratio: ${(scene.width / scene.height).toFixed(4)}`}>
    <figure class="plate" style={`--poster: url(${light})`}>
      <picture>
        <source media="(prefers-reduced-motion: reduce) and (prefers-color-scheme: dark)" srcset={dark} />
        <source media="(prefers-reduced-motion: reduce)" srcset={light} />
        <img src={scene.src} width={scene.width} height={scene.height} alt={scene.desc || scene.title} data-themed={themed(scene.svg) ? "" : undefined} />
      </picture>
    </figure>
    <div class="meta">
      <h1>{scene.title}</h1>
      <a class="source" href={`${SOURCES}/${name}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        Source
      </a>
      <nav class="step" aria-label="Examples">
        <a href={`/examples/${prev.name}`} title={prev.scene.title} aria-label={`Previous: ${prev.scene.title}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></a>
        <a href={`/examples/${next.name}`} title={next.scene.title} aria-label={`Next: ${next.scene.title}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></a>
      </nav>
    </div>
  </main>
  <footer class="wrap foot"><span>One animated SVG, no runtime JavaScript.</span><nav aria-label="Footer"><a href={REPO}>GitHub</a><a href="/">Home</a></nav></footer>
</Base>

<script>
  import { follow } from "../../scripts/follow";

  follow(document.querySelector(".plate img")!);

  // The arrow keys step through the examples, like the buttons under the scene.
  const [prev, next] = document.querySelectorAll<HTMLAnchorElement>(".step a");
  addEventListener("keydown", (event: KeyboardEvent) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.target instanceof HTMLInputElement) return;
    if (event.key === "ArrowLeft") prev!.click();
    if (event.key === "ArrowRight") next!.click();
  });
</script>
