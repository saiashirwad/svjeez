---
import { hero, heroImage, cueImage, examplesCueImage, introCueImage } from "../hero";
import { REPO } from "../links";
import LiveScene from "./LiveScene.astro";
---

<section class="wrap hero">
  <h1>This is a <span class="ul">{hero.size}</span> SVG in an <code>&lt;img&gt;</code> tag.</h1>
  <p class="lede"><span>Written in TypeScript and JSX.</span> <span><strong>No player. No JavaScript.</strong></span></p>
  <div class="hero-stage">
    <LiveScene class="hero-scene" scene={heroImage} cost={hero.cost} alt={hero.alt} />
  </div>
  <nav class="hero-next" aria-label="Next">
    <a href="#start" aria-label="Play with svjeez"><LiveScene class="cue" scene={cueImage} cost={6} alt="" /></a>
    <a href="/video" aria-label="Watch the film"><LiveScene class="cue" scene={introCueImage} cost={4} alt="" /></a>
    <a href={`${REPO}/tree/main/examples`} aria-label="Browse examples"><LiveScene class="cue" scene={examplesCueImage} cost={4} alt="" /></a>
  </nav>
</section>
