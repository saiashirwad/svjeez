---
// The hero: one scene at the size it plays, and what it is, said with the real size of the file on screen.
import { hero, heroImage, cueImage, examplesCueImage, introCueImage } from "../hero";
import LiveScene from "./LiveScene.astro";
---

<section class="wrap hero">
  <h1>This is a <span class="ul">{hero.size}</span> SVG in an <code>&lt;img&gt;</code> tag.</h1>
  <div class="hero-stage">
    <LiveScene class="hero-scene" scene={heroImage} cost={hero.cost} alt={hero.alt} />
  </div>
  <nav class="hero-next" aria-label="Next">
    <a href="#play" aria-label="Play with svjeez"><LiveScene class="cue" scene={cueImage} cost={6} alt="" /></a>
    <a href="/intro" aria-label="Watch the intro"><LiveScene class="cue" scene={introCueImage} cost={4} alt="" /></a>
    <a href="/examples/" aria-label="Browse examples"><LiveScene class="cue" scene={examplesCueImage} cost={4} alt="" /></a>
  </nav>
</section>
