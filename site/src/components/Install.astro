---
import CopyIcon from "./CopyIcon.astro";

interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="install">
  <code><b>$</b> <span>{command}</span></code><button type="button" data-copy={command} aria-label="Copy the install command" title="Copy the install command"><CopyIcon /></button>
  <span class="copy-say" role="status"></span>
</div>

<script>
  import { copy } from "../scripts/copy";

  for (const button of document.querySelectorAll<HTMLButtonElement>(".install [data-copy]")) {
    const install = button.parentElement!;

    button.addEventListener("click", () =>
      copy(button, button.dataset.copy!, {
        say: install.querySelector(".copy-say")!,
        fallback: install.querySelector("code span")!,
      }),
    );
  }
</script>
