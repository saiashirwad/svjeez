---
import { getScene } from "@svjeez/astro/scene";
import { svg } from "svjeez/tools";
import mascot from "../scenes/mascot";
import { github, moon, sun, system } from "../scenes/nav-icons";

interface Props {
  current?: "examples";
  wide?: boolean;
}

const { current, wide } = Astro.props;

const blip = getScene(mascot);

const links: { href: string; label: string; page?: string }[] = [{ href: "https://github.com/saiashirwad/svjeez", label: "GitHub" }];

const optional: string[] = [];

// The icons are inlined, so they paint with the page's own colors: their ink is currentColor and their --bg the page's.
const icon = (scene: Parameters<typeof svg.emit>[0], prefix: string) =>
  svg
    .emit(scene, { prefix })
    .replace(/^.*svg\.\w+root\{--ink.*\n/gm, "")
    .replaceAll("var(--ink)", "currentColor");
---

<header class:list={["wrap top", { wide }]}>
  <a class="brand" href="/"><img src={blip.src} width="26" height="26" alt="" /><span>svjeez</span></a>
  <nav aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-label={link.label === "GitHub" ? "GitHub" : undefined} class:list={{ opt: optional.includes(link.label) }} aria-current={current && link.page === current ? "page" : undefined}>
          {link.label === "GitHub" && (
            <span class="gh nav-ico" aria-hidden="true" set:html={icon(github, "gh")} />
          )}
          {link.label !== "GitHub" && <span>{link.label}</span>}
        </a>
      ))
    }
    <div class="controls">
      <div class="scheme" role="radiogroup" aria-label="Color scheme" data-at="system">
        <span class="knob" aria-hidden="true"><img src={blip.src} width="26" height="26" alt="" /></span>
        <button type="button" role="radio" aria-checked="false" data-scheme="light" aria-label="Light" title="Light"><span class="nav-ico" aria-hidden="true" set:html={icon(sun, "sun")} /></button>
        <button type="button" role="radio" aria-checked="true" data-scheme="system" aria-label="System" title="System"><span class="nav-ico" aria-hidden="true" set:html={icon(system, "sys")} /></button>
        <button type="button" role="radio" aria-checked="false" data-scheme="dark" aria-label="Dark" title="Dark"><span class="nav-ico" aria-hidden="true" set:html={icon(moon, "moon")} /></button>
      </div>
    </div>
  </nav>
</header>

<script>
  import { scheme, THEMECHANGE } from "../scripts/scheme";

  const icons = [...document.querySelectorAll<HTMLElement>(".top .nav-ico")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  const play = (icon: HTMLElement) => {
    if (!calm.matches) icon.setAttribute("data-on", "");
  };

  for (const icon of icons) {
    const host = icon.closest("a, button")!;
    host.addEventListener("pointerenter", () => play(icon));
    icon.addEventListener("animationiteration", () => {
      if (!host.matches(":hover")) icon.removeAttribute("data-on");
    });
  }

  let next = 0;

  setInterval(() => {
    const shown = icons.filter((icon) => icon.offsetParent !== null);

    if (shown.length) play(shown[next++ % shown.length]!);
  }, 6000);

  // The slider picks light, system or dark. It sets `color-scheme` on the page, and Chromium hands that to every <img>
  // SVG on it; system removes the choice so the page follows the OS again. Blip on the knob hops on every move.
  const slider = document.querySelector<HTMLElement>(".scheme")!;
  const stops = [...slider.querySelectorAll<HTMLButtonElement>("[data-scheme]")];
  const chosen = () => document.documentElement.dataset.theme ?? "system";

  const showScheme = () => {
    slider.dataset.at = chosen();
    stops.forEach((stop) => stop.setAttribute("aria-checked", String(stop.dataset.scheme === chosen())));
  };

  const bump = (element: HTMLElement) => {
    element.removeAttribute("data-bump");
    void element.offsetWidth;
    element.setAttribute("data-bump", "");
  };

  showScheme();

  slider.addEventListener("click", (event) => {
    const stop = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-scheme]") : null;
    const next = stop?.dataset.scheme;

    if (!next || next === chosen()) return;
    const before = scheme();

    if (next === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = next;

    try {
      if (next === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", next);
    } catch {}

    showScheme();
    bump(slider);

    if (scheme() !== before) dispatchEvent(new Event(THEMECHANGE));
  });
</script>
