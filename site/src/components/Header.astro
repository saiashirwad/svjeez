---
import { getScene } from "@svjeez/astro/scene";
import mascot from "@examples/site/mascot.tsx";
import { github, moon, sun, system, word } from "@examples/site/nav-icons.tsx";
import { PALETTES, type Palette } from "../palettes";

interface Props {
  current?: "examples" | "intro" | "play";
  wide?: boolean;
}

const { current, wide } = Astro.props;

// The chick from the favicon, alive: it blinks and hops on a long loop, and holds still for a reader who asks for less motion.
const chick = getScene(mascot);

const links = [
  ...(current === "play" ? [{ href: "/play", label: "Playground", page: "play" }] : []),
  { href: "https://github.com/saiashirwad/svjeez", label: "GitHub" },
];

// On the playground page the extra link would crowd a phone, so GitHub gives way.
const optional = current === "play" ? ["GitHub"] : [];
const SWATCH = ["base00", "base08", "base0B", "base0D", "base0E"] as const;
const swatches = ({ light, dark }: Palette) => SWATCH.map((slot, i) => `--s${i}: light-dark(${light[slot]}, ${dark[slot]})`).join("; ");
---

<header class:list={["wrap top", { wide }]}>
  <a class="brand" href="/"><img src={chick.src} width="26" height="26" alt="" /><span>svjeez</span></a>
  <nav aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-label={link.label === "GitHub" ? "GitHub" : undefined} class:list={{ opt: optional.includes(link.label) }} aria-current={current && link.page === current ? "page" : undefined}>
          {link.label === "GitHub" && (
            <span class="gh nav-ico" aria-hidden="true" set:html={github()} />
          )}
          {link.label === "GitHub" ? <span class="word" aria-hidden="true" set:html={word("GitHub", "ghw")} /> : <span>{link.label}</span>}
        </a>
      ))
    }
    <div class="controls">
      {/* Four palettes, one little color wheel each: click one to wear it. */}
      <div class="palettes" role="radiogroup" aria-label="Color palette">
        {
          PALETTES.map((p) => (
            <button type="button" role="radio" aria-checked="false" data-palette={p.id} style={swatches(p)} title={p.label} aria-label={p.label}>
              <span class="pie" aria-hidden="true" />
            </button>
          ))
        }
      </div>
      {/* Light, system and dark on a slider, with the chick riding the knob. */}
      <div class="scheme" role="radiogroup" aria-label="Color scheme" data-at="system">
        <span class="knob" aria-hidden="true"><img src={chick.src} width="26" height="26" alt="" /></span>
        <button type="button" role="radio" aria-checked="false" data-scheme="light" aria-label="Light" title="Light"><span class="nav-ico" aria-hidden="true" set:html={sun()} /></button>
        <button type="button" role="radio" aria-checked="true" data-scheme="system" aria-label="System" title="System"><span class="nav-ico" aria-hidden="true" set:html={system()} /></button>
        <button type="button" role="radio" aria-checked="false" data-scheme="dark" aria-label="Dark" title="Dark"><span class="nav-ico" aria-hidden="true" set:html={moon()} /></button>
      </div>
    </div>
  </nav>
</header>

<script>
  import { PALETTES } from "../palettes";
  import { choose, palette } from "../scripts/palette";
  import { scheme, THEMECHANGE } from "../scripts/scheme";

  // Each header icon is a svjeez scene held at its first frame. Pointing at its button plays it, and it always finishes
  // the loop it is in before it rests, so it never freezes halfway. Every few seconds one of them plays on its own.
  const icons = [...document.querySelectorAll<HTMLElement>(".top .nav-ico")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  const play = (icon: HTMLElement) => {
    if (!calm.matches) icon.setAttribute("data-on", "");
  };

  for (const icon of icons) {
    const host = icon.closest("a, button")!;
    host.addEventListener("pointerenter", () => play(icon));
    // A loop has come round to its first frame: rest there unless the pointer is still on the button.
    icon.addEventListener("animationiteration", () => {
      if (!host.matches(":hover")) icon.removeAttribute("data-on");
    });
  }

  let next = 0;
  setInterval(() => {
    const shown = icons.filter((icon) => icon.offsetParent !== null);
    if (shown.length) play(shown[next++ % shown.length]!);
  }, 6000);

  // The slider picks light, system or dark. It sets `color-scheme` on the page, and Chromium hands that to every <img>
  // SVG on it; system removes the choice so the page follows the OS again. The chick on the knob hops on every move.
  const slider = document.querySelector<HTMLElement>(".scheme")!;
  const stops = [...slider.querySelectorAll<HTMLButtonElement>("[data-scheme]")];
  const chosen = () => document.documentElement.dataset.theme ?? "system";

  const showScheme = () => {
    slider.dataset.at = chosen();
    stops.forEach((stop) => stop.setAttribute("aria-checked", String(stop.dataset.scheme === chosen())));
  };

  const bump = (element: HTMLElement) => {
    element.removeAttribute("data-bump");
    void element.offsetWidth;
    element.setAttribute("data-bump", "");
  };

  showScheme();

  slider.addEventListener("click", (event) => {
    const stop = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-scheme]") : null;
    const next = stop?.dataset.scheme;

    if (!next || next === chosen()) return;
    const before = scheme();

    if (next === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = next;

    try {
      if (next === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", next);
    } catch {}

    showScheme();
    bump(slider);

    if (scheme() !== before) dispatchEvent(new Event(THEMECHANGE));
  });

  // The palettes: a click wears one, and its wheel gives a happy spin.
  const wheels = [...document.querySelectorAll<HTMLButtonElement>(".palettes [data-palette]")];
  const mark = () => wheels.forEach((wheel) => wheel.setAttribute("aria-checked", String(wheel.dataset.palette === palette())));

  mark();

  for (const wheel of wheels)
    wheel.addEventListener("click", () => {
      const picked = PALETTES.find((p) => p.id === wheel.dataset.palette);

      if (!picked) return;
      choose(picked.id);
      mark();
      bump(wheel);
    });
</script>
