---
import { getScene } from "@svjeez/astro/scene";
import mascot from "@examples/site/mascot.tsx";
import { PALETTES, type Palette } from "../palettes";

interface Props {
  current?: "examples" | "intro" | "play";
  wide?: boolean;
}

const { current, wide } = Astro.props;
// The chick from the favicon, alive: it blinks and hops on a long loop, and holds still for a reader who asks for less motion.
const chick = getScene(mascot);

const links = [
  { href: "/examples/", label: "Examples", page: "examples" },
  ...(current === "play" ? [{ href: "/play", label: "Playground", page: "play" }] : []),
  { href: "/intro", label: "Intro", page: "intro" },
  { href: "https://github.com/saiashirwad/svjeez", label: "GitHub" },
];

// On the playground page the extra link would crowd a phone, so the last two give way.
const optional = current === "play" ? ["Intro", "GitHub"] : [];
const SWATCH = ["base00", "base08", "base0B", "base0D", "base0E"] as const;
const swatches = ({ light, dark }: Palette) => SWATCH.map((slot, i) => `--s${i}: light-dark(${light[slot]}, ${dark[slot]})`).join("; ");
---

<header class:list={["wrap top", { wide }]}>
  <a class="brand" href="/"><img src={chick.src} width="26" height="26" alt="" /><span>svjeez</span></a>
  <nav aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} class:list={{ opt: optional.includes(link.label) }} aria-current={current && link.page === current ? "page" : undefined}>
          {link.label === "GitHub" && (
            <svg class="gh" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg>
          )}
          <span>{link.label}</span>
        </a>
      ))
    }
    <div class="controls">
    <button class="pick" type="button" popovertarget="palettes" aria-haspopup="menu" aria-label="Choose a color palette" title="Color palette">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="pick-label" aria-hidden="true">Colors</span>
      <svg class="chev" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5"></path></svg>
    </button>
    <div class="palettes" id="palettes" popover role="menu" aria-label="Color palette">
      {
        PALETTES.map((p) => (
          <button type="button" role="menuitemradio" aria-checked="false" tabindex="-1" data-palette={p.id} style={swatches(p)}>
            <span class="sw" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            {p.label}
          </button>
        ))
      }
    </div>
    <button class="theme" type="button" aria-label="Color scheme: system" title="Color scheme: system">
      <svg class="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12.5" rx="2"></rect><path d="M8.5 20.5h7M12 16.5v4"></path></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path></svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
    </button>
    </div>
  </nav>
</header>

<script>
  import { PALETTES } from "../palettes";
  import { choose, palette } from "../scripts/palette";
  import { scheme, THEMECHANGE } from "../scripts/scheme";

  // The toggle cycles system, light and dark. It sets `color-scheme` on the page, and Chromium hands that to every
  // <img> SVG on it; system removes the choice so the page follows the OS again.
  const toggle = document.querySelector<HTMLButtonElement>(".theme")!;

  const NEXT = new Map([
    ["system", "light"],
    ["light", "dark"],
    ["dark", "system"],
  ]);

  const chosen = () => document.documentElement.dataset.theme ?? "system";

  const label = () => {
    const text = `Color scheme: ${chosen()}`;
    toggle.ariaLabel = text;
    toggle.title = text;
  };

  label();

  toggle.addEventListener("click", () => {
    const next = NEXT.get(chosen()) ?? "system";
    const before = scheme();

    if (next === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = next;

    try {
      if (next === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", next);
    } catch {}

    label();

    if (scheme() !== before) dispatchEvent(new Event(THEMECHANGE));
  });

  // A menu of radio items: arrows move between them, Enter or a click picks one, Escape and Tab close it.
  const menu = document.querySelector<HTMLElement>("#palettes")!;
  const items = [...menu.querySelectorAll<HTMLButtonElement>("[role=menuitemradio]")];
  const mark = () => items.forEach((item) => item.setAttribute("aria-checked", String(item.dataset.palette === palette())));

  mark();

  menu.addEventListener("toggle", (event) => {
    // SAFETY: the popover fires toggle as a ToggleEvent, which carries newState.
    if ((event as ToggleEvent).newState === "open") items.find((item) => item.ariaChecked === "true")?.focus();
  });

  menu.addEventListener("click", (event) => {
    const item =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>("[role=menuitemradio]")
        : null;

    const picked = PALETTES.find((p) => p.id === item?.dataset.palette);

    if (!picked) return;
    choose(picked.id);
    mark();
    menu.hidePopover();
  });

  menu.addEventListener("keydown", (event) => {
    const at = items.findIndex((item) => item === document.activeElement);

    const to = new Map([
      ["ArrowDown", at + 1],
      ["ArrowUp", at - 1],
      ["Home", 0],
      ["End", -1],
    ]).get(event.key);

    if (event.key === "Tab") return menu.hidePopover();

    if (to === undefined) return;
    event.preventDefault();
    items.at(to % items.length)!.focus();
  });
</script>
