{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "svjeez",
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "customConditions": ["@svjeez/source"],
    "paths": {
      "@examples/*": ["../packages/svjeez/examples/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
