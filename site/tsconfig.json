{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "svjeez",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "svjeez": ["../src/index.ts"],
      "svjeez/jsx-runtime": ["../src/jsx-runtime.ts"],
      "svjeez/jsx-dev-runtime": ["../src/jsx-dev-runtime.ts"],
      "svjeez/extras": ["../src/extras.ts"],
      "svjeez/frames": ["../src/frames.ts"],
      "@examples/*": ["../examples/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
