{
  "name": "svjeez-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "scene": "bun ../scripts/scene.ts",
    "dev": "bun run ../packages/svjeez/src/cli.ts dev",
    "render-png": "bun run ../packages/svjeez/src/cli.ts frames",
    "perf": "bun run scripts/perf.ts",
    "render-video": "bun run ../packages/svjeez/src/cli.ts video",
    "test": "bun test",
    "live": "vite live-editor",
    "test:browsers": "bun test ./scripts/browsers.ts",
    "test:node": "tsx scripts/node-check.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dom-react && tsc --noEmit -p dom-react-vite && tsc --noEmit -p dom-component && tsc --noEmit -p live-editor && svelte-check --tsconfig dom-svelte/tsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@svjeez/charts": "workspace:*",
    "@svjeez/code": "workspace:*",
    "@svjeez/diagrams": "workspace:*",
    "@svjeez/dom": "workspace:*",
    "@svjeez/fonts": "workspace:*",
    "@svjeez/geo": "workspace:*",
    "@svjeez/icons": "workspace:*",
    "@svjeez/live": "workspace:*",
    "@svjeez/math": "workspace:*",
    "@svjeez/mermaid": "workspace:*",
    "@svjeez/video": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-plugin-svelte": "^0.0.6",
    "effect": "^4.1.4",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svjeez": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "8.3.5",
    "world-atlas": "^2.0.2"
  }
}
